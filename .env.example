# ===== 应用配置 =====
PROJECT_NAME=fastapi-langgraph-agent-backend
API_V1_PREFIX=/api/v1
DEBUG=false

# 允许跨域的前端源（逗号分隔）；生产环境务必改为你的前端域名，不要用 *
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== 安全（生产环境务必修改 SECRET_KEY）=====
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
# 或：openssl rand -base64 32
SECRET_KEY=change-me-to-a-random-secret-string
# 设为 true 后，若 SECRET_KEY 仍是默认占位值则启动直接报错，防止误用弱密钥
REQUIRE_SECRET_KEY=false
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===== 数据库（PostgreSQL）=====
# 本地直连
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agentdb
# Docker Compose 内使用下面的地址（容器间通信）
# DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/agentdb

# 启动是否自动建表（create_all）。
# 开发/本地：true 最省事；生产：false，改用 Alembic 迁移（alembic upgrade head），
# 否则改表结构时 create_all 不会去 ALTER 已有表，易引发字段不一致、丢数据。
AUTO_CREATE_TABLES=true

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0
# Docker Compose 内使用：redis://redis:6379/0

# ===== 大模型 API =====
# 支持 OpenAI / DeepSeek / 通义千问 等兼容 OpenAI 接口的模型
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_OWN_KEY
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ===== LangGraph Checkpointer（Agent 多轮记忆 / 可恢复）=====
# 留空：使用内存版 MemorySaver（进程重启即清空，适合开发 / 单实例演示）
# 持久化（跨重启可恢复）：sqlite:///./data/checkpoints.sqlite
#   需额外安装：pip install langgraph-checkpoint-sqlite
CHECKPOINTER_URI=

# ===== Token 用量统计 =====
# 是否在 /usage 接口给已知模型估算成本（美元）。未知模型返回 null。
TOKEN_USAGE_COST_ENABLED=true

# ===== 登录失败锁定（防暴力破解）=====
# 同一账号在窗口内（LOGIN_LOCKOUT_WINDOW_MINUTES）连续失败达
# LOGIN_MAX_FAILED_ATTEMPTS 次即锁定 LOGIN_LOCKOUT_MINUTES 分钟。
# Redis 不可用时自动降级（不锁定）。
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_LOCKOUT_WINDOW_MINUTES=15

# ===== 嵌入模型（用于 RAG 知识库）=====
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# 单文件上传上限（字节，默认 10 MiB）与单次检索片段数上限
MAX_KNOWLEDGE_UPLOAD_BYTES=10485760
MAX_KNOWLEDGE_K=10

# ===== 限流（基于 Redis；Redis 不可用时自动降级放行，不会拖垮主流程）=====
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10   # 登录：每 IP 每分钟，防暴力破解
RATE_LIMIT_CHAT_PER_MINUTE=30    # 对话：每用户每分钟，防刷 token 成本

# ===== 本地数据目录 =====
CHROMA_PERSIST_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
